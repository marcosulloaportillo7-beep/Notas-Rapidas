<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NotasRapidas.Views.HistorialPage"
             Title="Historial">

    <CollectionView
        x:Name="HistorialCollection">

        <CollectionView.ItemTemplate>
            <DataTemplate>

                <VerticalStackLayout Padding="15">

                    <Label
                        Text="{Binding Accion}" />

                    <Label
                        Text="{Binding Fecha}" />

                </VerticalStackLayout>

            </DataTemplate>
        </CollectionView.ItemTemplate>

    </CollectionView>

    
</ContentPage>