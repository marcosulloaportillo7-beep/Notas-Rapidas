<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NotasRapidas.Views.DetalleNotaPage"
             Title="Detalles Nota">


    <ScrollView>

        <VerticalStackLayout Padding="20">

            <Entry
                x:Name="TituloEntry"
                Placeholder="Título"
                MaxLength="100"/>

            <Editor
                x:Name="ContenidoEditor"
                HeightRequest="150"/>

            <Button
                Text="Guardar"
                Clicked="Guardar_Clicked"/>

        </VerticalStackLayout>

    </ScrollView>


</ContentPage>