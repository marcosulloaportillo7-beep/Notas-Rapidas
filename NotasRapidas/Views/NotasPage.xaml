<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NotasRapidas.Views.NotasPage"
             Title="Notas">


    <VerticalStackLayout Padding="10">

        <Button
            Text="Nueva Nota"
            Clicked="NuevaNota_Clicked"/>

        <CollectionView
            x:Name="NotasCollection"
            SelectionMode="Single"
            SelectionChanged="NotasCollection_SelectionChanged">

            <CollectionView.ItemTemplate>
                <DataTemplate>

                    <Frame Margin="5">

                        <VerticalStackLayout>

                            <Label
                                TextColor="Black"
                                Text="{Binding Titulo}"
                                FontAttributes="Bold"/>

                            <Label
                                TextColor="Black"
                                Text="{Binding FechaCreacion}"/>

                        </VerticalStackLayout>

                    </Frame>

                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

    </VerticalStackLayout>


</ContentPage>